Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Define", " ", "the", " ", "DDE", " ", "system"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"eq1", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"oM", "'"}], "[", "t", "]"}], "==", 
      RowBox[{
       RowBox[{"nF", "[", "t", "]"}], "-", 
       RowBox[{
        SubscriptBox["\[Alpha]", "m"], " ", 
        RowBox[{"oM", "[", "t", "]"}]}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"eq2", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"oP", "'"}], "[", "t", "]"}], "==", 
      RowBox[{
       RowBox[{
        SubscriptBox["\[Beta]", "p"], " ", 
        RowBox[{"oM", "[", 
         RowBox[{"t", "-", 
          SubscriptBox["\[Tau]", "p"]}], "]"}]}], "-", 
       RowBox[{
        SubscriptBox["\[Alpha]", "p"], " ", 
        RowBox[{"oP", "[", "t", "]"}]}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"nF", "[", "t_", "]"}], ":=", 
     FractionBox[
      SubscriptBox["\[Beta]", "m"], 
      RowBox[{"1", "+", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"oP", "[", 
           RowBox[{"t", "-", 
            SubscriptBox["\[Tau]", "m"]}], "]"}], "^", "2"}], "/", 
         RowBox[{"k", "^", "2"}]}], ")"}]}]]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Define", " ", "history", " ", "functions"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"iniO", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"oP", "[", 
         RowBox[{"t", "/;", 
          RowBox[{"t", "<=", "0."}]}], "]"}], "==", "0."}], ",", 
       RowBox[{
        RowBox[{"oM", "[", 
         RowBox[{"t", "/;", 
          RowBox[{"t", "<=", "0."}]}], "]"}], "==", "0."}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Define", " ", "parameter", " ", "ranges"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"evalTime", " ", "=", " ", "3000."}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"alphaPValues", "=", 
     RowBox[{"Range", "[", 
      RowBox[{"0.17", ",", "2.9", ",", "0.2"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"timeSamples", "=", 
     RowBox[{"Range", "[", 
      RowBox[{"1000.", ",", "2000.", ",", "0.5"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Initialize", " ", "an", " ", "empty", " ", "list", " ", "to", " ", 
     "collect", " ", "results"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"results", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Solve", " ", "for", " ", "each", " ", "alphaP", " ", "with", " ", 
     "other", " ", "parameters", " ", "fixed"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"sol", "=", 
        RowBox[{"NDSolve", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Join", "[", 
              RowBox[{
               RowBox[{"{", 
